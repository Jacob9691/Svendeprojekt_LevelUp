{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "LevelUp.Api",
    "Audience": "LevelUp.Frontend",
    "AccessTokenMinutes": 60,
    "TwoFactorTokenMinutes": 10
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "FromAddress": "noreply@levelup.local",
    "FromName": "LevelUp"
  },
  "RateLimiting": {
    "AuthRequestsPerMinute": 10
  }
}
